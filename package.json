{
  "name": "@magicskysword/fairygui-mcp-headless",
  "version": "0.1.5",
  "description": "Headless FairyGUI authoring MCP server for AI agents",
  "type": "module",
  "license": "MIT",
  "author": "magicskysword",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicskysword/FairyGUI-MCP-Headless.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fairygui-mcp-headless": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:implemented",
    "test:implemented": "node --import tsx --test \"test/implemented/**/*.test.ts\"",
    "test:future": "node --import tsx --test \"test/future/**/*.test.ts\"",
    "test:all": "pnpm test:implemented && pnpm test:future",
    "test:corpus": "node --import tsx test/corpus/fairygui-unity.smoke.ts",
    "benchmark:corpus": "node --import tsx scripts/performance-baseline.ts",
    "test:pack": "node --import tsx scripts/pack-smoke.ts"
  },
  "dependencies": {
    "@magicskysword/fairygui-dom": "^1.1.2",
    "@magicskysword/openfairygui-core": "^0.2.5",
    "@magicskysword/openfairygui-functions": "^0.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^5.0.0",
    "playwright": "^1.61.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.10.0"
}
