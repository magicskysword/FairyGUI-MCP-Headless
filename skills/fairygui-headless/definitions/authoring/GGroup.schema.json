    "layout": {
      "type": "number"
    },
    "x": {
      "type": "number",
      "description": "Logical pixels."
    },
    "y": {
      "type": "number",
      "description": "Logical pixels."
    },
    "width": {
      "type": "number",
      "minimum": 0,
      "description": "Logical pixels."
    },
    "height": {
      "type": "number",
      "minimum": 0,
