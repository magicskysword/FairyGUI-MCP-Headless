{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GGraph",
  "type": "object",
  "properties": {
    "graphType": {
      "type": "number"
    },
    "x": {
      "type": "number",
      "description": "Logical pixels."
    },
    "y": {
      "type": "number",
      "description": "Logical pixels."
    },
    "width": {
      "type": "number",
      "minimum": 0,
      "description": "Logical pixels."
    },
    "height": {
      "type": "number",
      "minimum": 0,
      "description": "Logical pixels."
    },
    "locked": {
      "type": "boolean"
    },
    "minWidth": {
      "type": "number"
    },
    "maxWidth": {
      "type": "number"
    },
    "minHeight": {
      "type": "number"
    },
    "maxHeight": {
      "type": "number"
    },
    "pivotX": {
      "type": "number",
      "description": "Normalized pivot coordinate."
    },
    "pivotY": {
      "type": "number",
      "description": "Normalized pivot coordinate."
    },
    "pivotAsAnchor": {
      "type": "boolean"
    },
    "group": {
      "type": "string"
    },
    "skewX": {
      "type": "number"
    },
    "skewY": {
      "type": "number"
    },
    "alpha": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rotation": {
      "type": "number"
    },
    "visible": {
      "type": "boolean"
    },
    "touchable": {
      "type": "boolean"
    },
    "grayed": {
      "type": "boolean"
    },
    "lineSize": {
      "type": "number"
    },
    "lineColor": {
      "type": "string"
    },
    "fillColor": {
      "type": "string"
    },
    "cornerRadius": {
      "type": [
        "null",
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "points": {
      "type": [
        "null",
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "sides": {
      "type": "number"
    },
    "startAngle": {
      "type": "number"
    },
    "distances": {
      "type": [
        "null",
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "customData": {
      "type": "string"
    },
    "relations": {
      "type": "array"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [],
  "additionalProperties": false
}
