{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GTextInput",
  "type": "object",
  "properties": {
    "promptText": {
      "type": "string"
    },
    "maxLength": {
      "type": "number"
    },
    "restrict": {
      "type": "string"
    },
    "password": {
      "type": "boolean"
    },
    "keyboardType": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "x": {
      "type": "number",
      "description": "Logical pixels."
    },
    "y": {
      "type": "number",
      "description": "Logical pixels."
    },
    "width": {
      "type": "number",
      "minimum": 0,
      "description": "Logical pixels."
    },
    "height": {
      "type": "number",
      "minimum": 0,
      "description": "Logical pixels."
    },
    "minWidth": {
      "type": "number"
    },
    "maxWidth": {
      "type": "number"
    },
    "minHeight": {
      "type": "number"
    },
    "maxHeight": {
      "type": "number"
    },
    "pivotX": {
      "type": "number",
      "description": "Normalized pivot coordinate."
    },
    "pivotY": {
      "type": "number",
      "description": "Normalized pivot coordinate."
    },
    "pivotAsAnchor": {
      "type": "boolean"
    },
    "group": {
      "type": "string"
    },
    "alpha": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rotation": {
      "type": "number"
    },
    "visible": {
      "type": "boolean"
    },
    "touchable": {
      "type": "boolean"
    },
    "grayed": {
      "type": "boolean"
    },
    "tooltips": {
      "type": "string"
    },
    "customData": {
      "type": "string"
    },
    "font": {
      "type": "string"
    },
    "fontSize": {
      "type": "number"
    },
    "color": {
      "type": "string"
    },
    "align": {
      "type": "number"
    },
    "vAlign": {
      "type": "number"
    },
    "leading": {
      "type": "number"
    },
    "letterSpacing": {
      "type": "number"
    },
    "autoSize": {
      "type": "number"
    },
    "singleLine": {
      "type": "boolean"
    },
    "autoClearText": {
      "type": "boolean"
    },
    "demoText": {
      "type": "string"
    },
    "templateVarsEnabled": {
      "type": "boolean"
    },
    "faceDilate": {
      "type": "number"
    },
    "underlaySoftness": {
      "type": "number"
    },
    "ubbEnabled": {
      "type": "boolean"
    },
    "underline": {
      "type": "boolean"
    },
    "italic": {
      "type": "boolean"
    },
    "bold": {
      "type": "boolean"
    },
    "strikethrough": {
      "type": "boolean"
    },
    "strokeColor": {
      "type": [
        "null",
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "strokeSize": {
      "type": "number"
    },
    "shadowColor": {
      "type": [
        "null",
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "shadowOffsetX": {
      "type": "number"
    },
    "shadowOffsetY": {
      "type": "number"
    },
    "shadowOffset": {
      "type": "object"
    },
    "relations": {
      "type": "array"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [],
  "additionalProperties": false
}
