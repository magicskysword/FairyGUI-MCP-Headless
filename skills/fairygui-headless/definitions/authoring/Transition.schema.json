{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transition",
  "type": "object",
  "properties": {
    "autoPlay": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "autoPlayTimes": {
      "type": [
        "number",
        "null"
      ]
    },
    "autoPlayDelay": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Seconds."
    },
    "options": {
      "type": [
        "number",
        "null"
      ]
    },
    "fps": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 240,
      "description": "Transition frames per second."
    },
    "name": {
      "type": "string"
    }
  },
  "required": [],
  "additionalProperties": false
}
